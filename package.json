{
  "name": "sean-piseth-ai",
  "version": "1.2.0",
  "private": true,
  "description": "SEAN PISETH AI — production-oriented multilingual Telegram AI SaaS platform.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:languages": "tsx scripts/check-language-regression.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@google/genai": "^1.17.0",
    "@grammyjs/parse-mode": "^2.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "grammy": "^1.38.3",
    "openai": "^5.19.1",
    "pino": "^9.9.0",
    "zod": "^4.1.5",
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
